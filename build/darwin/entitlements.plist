<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- PortAudio records through CoreAudio; Hardened Runtime gates microphone access
         on this entitlement in addition to the TCC prompt driven by
         NSMicrophoneUsageDescription in Info.plist. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>

    <!-- Bundled libraries and ggml modules share the app's signing team, so keep
         Hardened Runtime library validation enabled. -->
</dict>
</plist>
